APP_ENV=development
# Runtime role (RLS enforced)
DATABASE_URL=postgresql+asyncpg://gc_app:gc_app@localhost:5432/growthcognix
# Owner role (migrations only)
MIGRATION_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/growthcognix
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=["http://localhost:3000"]

# AI providers (free tiers)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=
